# morning-paper 環境変数のキー名一覧
#
# 値は書かない。実際の値は .env に置き、.env はコミットしない。
# モックモード（第1段階）ではどれも不要。すべての外部連携がモックのため、
# 未設定でも python -m src.simulate full は完走する。
#
# 本番では GitHub Secrets と Cloudflare Workers の環境変数に置く。
# このファイルは手元で --dry-run を試すときの控え。

# 実行モード。mock = 外部へ一切接続しない。real = 実接続。
MORNING_PAPER_MODE=mock

# --- 記事の執筆（GitHub Secrets）-------------------------------------------
# どちらか一方。API キーがあればそちらが優先され、公式 SDK で呼ぶ。
ANTHROPIC_API_KEY=
# 定額プランのトークン（claude setup-token で発行）。Claude Code の非対話モード
# （claude -p）を子プロセスで呼ぶ。SDK 直叩きでは 429 になる。
# 手元で試すときは CLAUDE_CLI に claude コマンドの場所を入れる（PATH に無い場合）。
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CLI=

# --- 翻訳・YouTube要約・執筆の降格先（GitHub Secrets）----------------------
GEMINI_API_KEY=

# --- YouTube の動画一覧（GitHub Secrets・任意）-----------------------------
# 無くても動く（非公式の RSS へ落ちる）が、RSS は日によって取れない。
# Google Cloud で YouTube Data API v3 を有効にして作る API キー。
YOUTUBE_API_KEY=

# --- 本文取得の4段目と探索の段階2（GitHub Secrets）------------------------
FIRECRAWL_API_KEY=

# --- X上の反応（GitHub Secrets）-------------------------------------------
# reactions.x_enabled を true にするときだけ必要。月$5前後かかる。
XAI_API_KEY=

# --- Slack（GitHub Secrets）-----------------------------------------------
# 必要な権限は chat:write と files:write。
SLACK_BOT_TOKEN=
# 投稿先チャンネルは通常 config.yml の slack.channel に書く。
# ここは config.yml を空にしたときの逃げ道。
SLACK_CHANNEL=

# --- Vault への書き込み（GitHub Secrets）----------------------------------
# Open Vault リポジトリの deploy key（書き込み可）。秘密鍵をそのまま入れる。
VAULT_DEPLOY_KEY=
# 既定は kage-goodworks/Open-Vault。変えるときだけ設定する。
VAULT_REPO=

# --- GitHub Releases の取得（任意）----------------------------------------
# 無くても動く。あるとレート制限が緩くなる。
GITHUB_TOKEN=

# --- Jina Reader（任意）---------------------------------------------------
# 無くても動く。あるとレート制限が緩くなる。
JINA_API_KEY=

# --- Cloudflare Workers 側に置くもの（.env ではなく wrangler secret put）--
# SLACK_SIGNING_SECRET   Slackからのリクエストの署名検証
# GH_DISPATCH_TOKEN      repository_dispatch の起動（repo スコープのみ）
